# S3 methods for the classes fitBatchMix()/runBatchMix()/
# batchSemiSupervisedMixtureModel()/assessConvergence() attach to their
# return values (see R/batchmixFitMethods.R) - registered explicitly so that
# dispatch on print()/summary()/format() works correctly from other packages
# and contexts, not just at the top-level prompt with batchmix attached.
S3method(print, batchmix_fit)
S3method(summary, batchmix_fit)
S3method(print, summary.batchmix_fit)
S3method(print, batchmix_fit_list)
S3method(summary, batchmix_fit_list)
S3method(print, summary.batchmix_fit_list)
S3method(format, batchmix_convergence)
S3method(print, batchmix_convergence)
S3method(print, batchmix_control)

# posterior (delayed registration: posterior is only suggested)
S3method(posterior::as_draws, batchmix_fit)
S3method(posterior::as_draws, batchmix_fit_list)
S3method(posterior::as_draws_array, batchmix_fit)
S3method(posterior::as_draws_array, batchmix_fit_list)
S3method(posterior::as_draws_df, batchmix_fit)
S3method(posterior::as_draws_df, batchmix_fit_list)
S3method(posterior::as_draws_matrix, batchmix_fit)
S3method(posterior::as_draws_matrix, batchmix_fit_list)
S3method(posterior::as_draws_list, batchmix_fit)
S3method(posterior::as_draws_list, batchmix_fit_list)
S3method(posterior::as_draws_rvars, batchmix_fit)
S3method(posterior::as_draws_rvars, batchmix_fit_list)
